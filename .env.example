# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# PostgreSQL/Supabase connection string for push subscriptions/reminder jobs
DATABASE_URL=

# Protects the cron endpoint. Configure the same value in your scheduler header.
CRON_SECRET=
